# Copie para .env e preencha. NUNCA versione o .env.
# Este arquivo e versionado: so placeholders aqui, nenhum valor real.

# --- Aplicacao ---
APP_ENV=local
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRA_MINUTOS=30
CORS_ORIGENS=http://localhost:5173

# --- Campanha / regras de negocio ---
ANO_LETIVO_ALVO=2027
# Fallback: o prazo real vem por titulo do sistema de gestao, quando existe.
DESCONTO_VALIDO_ATE=2027-01-31
LINK_WABA=https://wa.me/55XXXXXXXXXXX

# --- Banco de leitura (adapter nao incluido neste extrato publico) ---
# Sem token/database a API sobe com dados de demonstracao.
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=
# Ids de servico no sistema de gestao. Filtrar por id, nunca por nome:
# ha servicos inativos homonimos que ainda aparecem em titulos antigos.
SERVICO_IDS_MATRICULA=[1001,1002]
SERVICO_IDS_MATERIAL=[2001]

# --- WhatsApp (adapter nao incluido neste extrato publico) ---
# Faltando qualquer um destes, o OTP cai no fake de demonstracao.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# Content Template aprovado pela Meta, com UMA variavel: o codigo.
TWILIO_CONTENT_SID_OTP=

# --- OTP proprio ---
# Segredo separado do JWT: vazar um nao compromete o outro. Minimo 32 bytes.
OTP_SEGREDO=
OTP_DIGITOS=6
OTP_VALIDADE_MINUTOS=10
# Limites por CPF. Sao eles que impedem forca bruta no codigo de 6 digitos.
OTP_MAX_TENTATIVAS=5
OTP_MAX_ENVIOS=3
# Contagem distribuida (precisa de GCP_PROJECT). Configure politica de TTL no
# campo `expira_em` da colecao, senao os documentos se acumulam para sempre.
FIRESTORE_COLECAO_TENTATIVAS=otp_tentativas

# --- Armazenamento dos PDFs (adapter nao incluido neste extrato publico) ---
# Sem bucket configurado a API usa PDFs de demonstracao.
GCP_PROJECT=
GCS_BUCKET_BOLETOS=
GCS_PREFIXO_MATRICULA=matricula
GCS_PREFIXO_MATERIAL=material-didatico
